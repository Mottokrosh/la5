{
  "name": "la5",
  "version": "2.0.0",
  "private": true,
  "description": "Limited Audience static site",
  "author": "Frank Reding <frank.reding@gmail.com>",
  "type": "module",
  "scripts": {
    "dev": "eleventy --serve",
    "start": "netlify dev",
    "build": "eleventy --quiet",
    "photos:export": "npm --prefix tools/photo-export run export --",
    "photos:verify": "npm --prefix tools/photo-export run verify",
    "photos:json": "npm --prefix tools/photo-export run json"
  },
  "engines": {
    "node": ">= 22"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@netlify/blobs": "^11.1.3",
    "pagefind": "^1.5.2",
    "photoswipe": "^5.4.4"
  }
}
