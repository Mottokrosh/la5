---
pagination:
  data: catalog.models
  size: 1
  alias: model
permalink: "/models/{{ model.slug }}/"
bodyClass: model-details
eleventyComputed:
  title: "{{ model.name | safe }}"
---
<header>
  <div class="title">
    <a href="/models/" role="button" class="round" aria-label="All models">{% icon "arrow-left" %}</a>

    <h2>
      <span>{{ model.name }}</span>
      <small>Appears in {{ model.videosCount }} video{% if model.videosCount != 1 %}s{% endif %}</small>
    </h2>
  </div>

  <div class="picture">
    <div style="--x: {{ model.picX }}; --y: {{ model.picY }}"></div>
  </div>
</header>

{% set videos = catalog.videos | featuring(model.slug) %}
{% include "partials/video-grid.njk" %}

{% set modelPhotos = photos.daily | picturing(model.name) %}
{% if modelPhotos.length %}
<section class="model-photos">
  <link rel="stylesheet" href="/css/photoswipe.css">
  <script type="module" src="/js/photo-gallery.js"></script>
  <h3>In today’s <a href="/photos/">photos</a></h3>
  <photo-gallery>
    <div class="photo-grid">
      {% for photo in modelPhotos %}{% include "partials/photo-tile.njk" %}{% endfor %}
    </div>
  </photo-gallery>
</section>
{% endif %}
